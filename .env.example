# HTTP server
PORT=3333
HOST=0.0.0.0

# Shared secret required on every /api/v1 request:
#   Authorization: Bearer <VINTASEND_API_KEY>
VINTASEND_API_KEY=

# Comma-separated list of allowed browser origins for CORS.
# Leave empty when only server-side clients (like the dashboard) call this API.
VINTASEND_API_CORS_ORIGINS=

# Path to the module that builds your VintaSend service (see README).
# Relative paths resolve from the process working directory.
# Compiled server (npm start): ./dist/vintasend.config.js
# Dev server (npm run dev), which runs TypeScript directly: ./src/vintasend.config.ts
VINTASEND_SERVICE_MODULE=./dist/vintasend.config.js

# Optional: read from a non-primary backend registered in your VintaSend service
VINTASEND_BACKEND_IDENTIFIER=

# GitHub template preview configuration
GITHUB_REPO=
GITHUB_API_KEY=
# Optional: defaults to https://api.github.com
GITHUB_API_BASE_URL=
# Optional: base path prefixed to bodyTemplate/subjectTemplate paths before the GitHub fetch
GITHUB_TEMPLATES_BASE_PATH=
